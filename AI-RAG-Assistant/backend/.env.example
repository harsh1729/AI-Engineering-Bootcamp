# Copy to .env and adjust values as needed.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ai_rag_assistant
DATABASE_ECHO=false

# Image OCR uploads require the Tesseract binary installed locally.
# macOS: brew install tesseract
MAX_IMAGE_SIZE_MB=10

# Pinecone vector store (optional; enable Pinecone in RAG options when set).
# Create one cosine index per provider with matching dimensions.
PINECONE_API_KEY=pcsk_21ZDiv_99UwwE8aN7XGsCfGF7cP2G9wzshCMA4FuBpg8QGRZ1x1WVdQTdfTEjAXsRbgM3v
PINECONE_NAMESPACE=document-chunks
PINECONE_INDEX_OPENAI=ai-rag-openai-1536
PINECONE_INDEX_VOYAGE=ai-rag-voyage-1024
PINECONE_INDEX_COHERE=ai-rag-cohere-1536
PINECONE_DIMENSION_OPENAI=1536
PINECONE_DIMENSION_VOYAGE=1024
PINECONE_DIMENSION_COHERE=1536
# PINECONE_INDEX_NAME is a legacy alias for PINECONE_INDEX_OPENAI.

# pgvector vector store (enabled by default when Postgres has the vector extension).
PGVECTOR_ENABLED=true
PGVECTOR_TABLE_OPENAI=doc_pg_embeddings_openai
PGVECTOR_TABLE_VOYAGE=doc_pg_embeddings_voyage
PGVECTOR_TABLE_COHERE=doc_pg_embeddings_cohere

# Qdrant vector store (optional; enable Qdrant in RAG options when QDRANT_URL is set).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_OPENAI=ai-rag-openai-1536
QDRANT_COLLECTION_VOYAGE=ai-rag-voyage-1024
QDRANT_COLLECTION_COHERE=ai-rag-cohere-1536
QDRANT_DIMENSION_OPENAI=1536
QDRANT_DIMENSION_VOYAGE=1024
QDRANT_DIMENSION_COHERE=1536
